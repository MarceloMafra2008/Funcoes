//8 a 10 anos	Infantil B
//11-13 anos	Juvenil A
//14-17 anos	Juvenil B
//Maiores de 18 anos (inclusive)	Adulto


#include <stdio.h>


int tabela(int idade)
{
    int result = 0;
    
    if(idade >= 5 && idade <= 7)
    {
        result = 1;
    }
    else
    {
        if(idade >= 8 && idade <= 10)
        {
            result = 2;
        }
        else
        {
            if(idade >= 11 && idade <=13)
            {
                result = 3;
            }
            else
            {
                if(idade >= 14 && idade <= 17)
                {
                    result = 4;
                }
                else
                {
                    result = 5;
                }
            }
        }
    }
    return result;
}


