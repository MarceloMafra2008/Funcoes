#include <stdio.h>
#include <math.h>

float distancia(float x1, float x2, float y1, float y2)
{
    float calc;
    
    
    
    calc = sqrt(pow(x2-x1,2) + pow(y2-y1,2));
    
    return calc;
}


void imprime()
{
    int i;
    
    for(i=0; i<45; i++)
    {
        printf("*");
    }
}

int main()
{
    float x1, x2, y1, y2;
    float result;
    
    printf("\nInsira o valor de x1:");
    scanf("%f", &x1);
    
    imprime();
    
    printf("\nInsira o valor de x2:");
    scanf("%f", &x2);
    
    imprime();
    
    printf("\nInsira o valor de y1:");
    scanf("%f", &y1);
    
    imprime();
    
    printf("\nInsira o valor de y2:");
    scanf("%f", &y2);
    
    imprime();
    
    result = distancia(x1, x2, y1, y2);
    
    printf("\nDistancia dos pontos:%.2f", result);
    
    return 0;
    
}
