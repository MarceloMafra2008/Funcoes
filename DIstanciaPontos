/*1)	Escreva um programa que implementa o uso de uma a função que calcule e retorne a distância entre 
dois pontos ( x1, y1) e (x2, y2). Todos os números e valores de retorno devem ser do tipo float.*/


#include <stdio.h>
#include <math.h>
float quest()
{
    float valor;
    scanf("%f", &valor);
    
    return valor;
}
void caracter()
{
    int i;
    for(i=0; i<30; i++)
    {
        printf("*");
    }
}
float distan(float x1, float x2, float y1, float y2)
{
    float distancia;
    
    distancia = sqrt((x2-x1)*(x2-x1) + (y2-y1)*(y2-y1));
    
    return distancia;
}
int main()
{
    float x1, x2, y1, y2, resul;

    printf("\nInsira o primeiro valor do ponto 1:");
    x1 = quest();
    
    
    printf("\nInsira o segundo valor do ponto 1:");
    x2 = quest();
    
    printf("\nInsira o primeiro valor do ponto 2:");
    y1 = quest();
    
    printf("\nInsira o segundo valor do ponto 2:");
    y2 = quest();
    
    printf("\n");
    caracter();
    
    resul = distan(x1, x2, y1, y2);   
    printf("\nDISTANCIA entre pontos:%.2f", resul);
}

